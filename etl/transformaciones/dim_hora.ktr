    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var franja_horaria;
var hora_texto = (hora &lt; 10 ? "0" : "") + hora + ":00";

if (hora &lt;= 5) {
  franja_horaria = "Madrugada";
} else if (hora &lt;= 11) {
  franja_horaria = "Mañana";
} else if (hora &lt;= 17) {
  franja_horaria = "Tarde";
} else {
  franja_horaria = "Noche";
}

</jsScript_script>
      </jsScript>
    </jsScripts>
