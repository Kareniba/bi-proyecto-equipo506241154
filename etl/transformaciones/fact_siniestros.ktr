  <step>
    <name>Leer siniestros JSON</name>
    <type>JsonInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <include>N</include><include_field/><rownum>N</rownum><addresultfile>N</addresultfile><readurl>N</readurl><removeSourceField>N</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile><doNotFailIfNoFile>N</doNotFailIfNoFile><ignoreMissingPath>Y</ignoreMissingPath><defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file><name>${RUTA_FUENTES}/siniestross_bogota_2018_2020.json</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file>
    <fields>
      <field><name>CODIGO_ACCIDENTE</name><path>$[*].CODIGO_ACCIDENTE</path><type>Integer</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>FORMULARIO</name><path>$[*].FORMULARIO</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>FECHA_HORA_ACC</name><path>$[*].FECHA_HORA_ACC</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>GRAVEDAD</name><path>$[*].GRAVEDAD</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>CLASE_ACC</name><path>$[*].CLASE_ACC</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>DIRECCION</name><path>$[*].DIRECCION</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>LOCALIDAD</name><path>$[*].LOCALIDAD</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>LATITUD</name><path>$[*].LATITUD</path><type>Number</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>LONGITUD</name><path>$[*].LONGITUD</path><type>Number</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
    </fields>
    <limit>0</limit><IsInFields>N</IsInFields><IsAFile>N</IsAFile><valueField/>
    <shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/><uriNameFieldName/><rootUriNameFieldName/><extensionFieldName/><sizeFieldName/>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>80</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Quitar duplicados CODIGO_ACCIDENTE</name>
    <type>UniqueRowsByHashSet</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <store_values>Y</store_values><reject_duplicate_row>N</reject_duplicate_row><error_description/>
    <fields><field><name>CODIGO_ACCIDENTE</name></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>260</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>¿LOCALIDAD vacía?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Rellenar LOCALIDAD vacía</send_true_to>
    <send_false_to>Unir flujos</send_false_to>
    <compare><condition><negated>N</negated><leftvalue>LOCALIDAD</leftvalue><function>IS NULL</function><rightvalue/></condition></compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Rellenar LOCALIDAD vacía</name>
    <type>IfNull</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <replaceAllByValue/><replaceAllMask/><selectFields>Y</selectFields><selectValuesType>N</selectValuesType><setEmptyStringAll>N</setEmptyStringAll>
    <valuetypes></valuetypes>
    <fields><field><name>LOCALIDAD</name><value>DESCONOCIDA</value><mask/><set_empty_string>N</set_empty_string></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>620</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Unir flujos</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>

    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>800</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>normaliza_fecha_hora</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <formula><field_name>fecha_hora_txt</field_name><formula_string>LEFT([FECHA_HORA_ACC];19)</formula_string><value_type>String</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>980</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Convertir texto a fecha</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>CODIGO_ACCIDENTE</name><rename/><length>-2</length><precision>-2</precision></field>
      <field><name>FORMULARIO</name><rename/><length>-2</length><precision>-2</precision></field>
      <field><name>GRAVEDAD</name><rename/><length>-2</length><precision>-2</precision></field>
      <field><name>CLASE_ACC</name><rename/><length>-2</length><precision>-2</precision></field>
      <field><name>DIRECCION</name><rename/><length>-2</length><precision>-2</precision></field>
      <field><name>LOCALIDAD</name><rename/><length>-2</length><precision>-2</precision></field>
      <field><name>LATITUD</name><rename/><length>-2</length><precision>-2</precision></field>
      <field><name>LONGITUD</name><rename/><length>-2</length><precision>-2</precision></field>
      <field><name>fecha_hora_txt</name><rename/><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
      <meta><name>fecha_hora_txt</name><rename>fecha_hora</rename><type>Date</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy/MM/dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale>es_CO</date_format_locale><date_format_timezone>America/Bogota</date_format_timezone><lenient_string_to_number>N</lenient_string_to_number></meta>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1160</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Calcular llaves y métricas</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <formula><field_name>sk_tiempo</field_name><formula_string>YEAR([fecha_hora])*10000+MONTH([fecha_hora])*100+DAY([fecha_hora])</formula_string><value_type>Integer</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula>
    <formula><field_name>sk_hora</field_name><formula_string>HOUR([fecha_hora])</formula_string><value_type>Integer</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula>
    <formula><field_name>cantidad_siniestros</field_name><formula_string>1</formula_string><value_type>Integer</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula>
    <formula><field_name>es_fatal</field_name><formula_string>IF([GRAVEDAD]="CON MUERTOS";1;0)</formula_string><value_type>Integer</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula>
    <formula><field_name>es_con_heridos</field_name><formula_string>IF([GRAVEDAD]="CON HERIDOS";1;0)</formula_string><value_type>Integer</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula>
    <formula><field_name>es_solo_danos</field_name><formula_string>IF([GRAVEDAD]="SOLO DANOS";1;0)</formula_string><value_type>Integer</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula>
    <formula><field_name>indice_gravedad</field_name><formula_string>IF([GRAVEDAD]="CON MUERTOS";3;IF([GRAVEDAD]="CON HERIDOS";2;1))</formula_string><value_type>Number</value_type><value_length>4</value_length><value_precision>2</value_precision><replace_field/></formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1340</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Buscar sk_tipo_siniestro</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DW_LOCAL</connection><cache>Y</cache><cache_load_all>Y</cache_load_all><cache_size>0</cache_size>
    <lookup><schema/><table>dim_tipo_siniestro</table><orderby/><fail_on_multiple>N</fail_on_multiple><eat_row_on_failure>N</eat_row_on_failure>
      <key><name>CLASE_ACC</name><field>clase_acc</field><condition>=</condition><name2/></key>
      <key><name>GRAVEDAD</name><field>gravedad</field><condition>=</condition><name2/></key>
      <value><name>sk_tipo_siniestro</name><rename>sk_tipo_siniestro</rename><default>-1</default><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1520</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Buscar sk_ubicacion</name>
    <type>DBJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DW_LOCAL</connection><rowlimit>1</rowlimit><outer_join>Y</outer_join><replace_vars>N</replace_vars>
    <sql>SELECT sk_ubicacion FROM dim_ubicacion WHERE sk_ubicacion &gt; 0 AND localidad = ? AND direccion = ? AND ABS(latitud - ?) &lt; 0.000001 AND ABS(longitud - ?) &lt; 0.000001 ORDER BY sk_ubicacion LIMIT 1</sql>
    <parameter><field><name>LOCALIDAD</name><type>String</type></field><field><name>DIRECCION</name><type>String</type></field><field><name>LATITUD</name><type>Number</type></field><field><name>LONGITUD</name><type>Number</type></field></parameter>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1700</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Buscar semáforo más cercano (≤100 m)</name>
    <type>DBJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DW_LOCAL</connection><rowlimit>1</rowlimit><outer_join>Y</outer_join><replace_vars>N</replace_vars>
    <sql>SELECT sk_semaforo, ROUND(dist_m, 1) AS distancia_semaforo_m FROM (SELECT sk_semaforo, 6371000 * 2 * ASIN(SQRT(POW(SIN(RADIANS(latitud - ?) / 2), 2) + COS(RADIANS(?)) * COS(RADIANS(latitud)) * POW(SIN(RADIANS(longitud - ?) / 2), 2))) AS dist_m FROM dim_semaforo WHERE sk_semaforo &gt; 0 AND latitud IS NOT NULL AND longitud IS NOT NULL) t WHERE dist_m &lt;= 100 ORDER BY dist_m LIMIT 1</sql>
    <parameter><field><name>LATITUD</name><type>Number</type></field><field><name>LATITUD</name><type>Number</type></field><field><name>LONGITUD</name><type>Number</type></field></parameter>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1880</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Asignar -1 a llaves sin coincidencia</name>
    <type>IfNull</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <replaceAllByValue/><replaceAllMask/><selectFields>Y</selectFields><selectValuesType>N</selectValuesType><setEmptyStringAll>N</setEmptyStringAll>
    <valuetypes></valuetypes>
    <fields>
      <field><name>sk_ubicacion</name><value>-1</value><mask/><set_empty_string>N</set_empty_string></field>
      <field><name>sk_semaforo</name><value>-1</value><mask/><set_empty_string>N</set_empty_string></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>2060</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Validar sk_tiempo en dim_tiempo</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DW_LOCAL</connection><cache>Y</cache><cache_load_all>Y</cache_load_all><cache_size>0</cache_size>
    <lookup><schema/><table>dim_tiempo</table><orderby/><fail_on_multiple>N</fail_on_multiple><eat_row_on_failure>N</eat_row_on_failure>
      <key><name>sk_tiempo</name><field>sk_tiempo</field><condition>=</condition><name2/></key>
      <value><name>fecha</name><rename>fecha_dim_tiempo</rename><default/><type>Date</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>2240</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>¿Llave de tiempo válida?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Cargar fact_siniestros</send_true_to>
    <send_false_to>Rechazos sin llave de tiempo</send_false_to>
    <compare><condition><negated>N</negated><leftvalue>fecha_dim_tiempo</leftvalue><function>IS NOT NULL</function><rightvalue/></condition></compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>2420</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Cargar fact_siniestros</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DW_LOCAL</connection><commit>500</commit><update_bypassed>N</update_bypassed>
    <lookup><schema/><table>fact_siniestros</table>
      <key><name>CODIGO_ACCIDENTE</name><field>codigo_accidente</field><condition>=</condition><name2/></key>
      <value><name>codigo_accidente</name><rename>CODIGO_ACCIDENTE</rename><update>N</update></value>
      <value><name>formulario</name><rename>FORMULARIO</rename><update>Y</update></value>
      <value><name>sk_tiempo</name><rename>sk_tiempo</rename><update>Y</update></value>
      <value><name>sk_hora</name><rename>sk_hora</rename><update>Y</update></value>
      <value><name>sk_ubicacion</name><rename>sk_ubicacion</rename><update>Y</update></value>
      <value><name>sk_tipo_siniestro</name><rename>sk_tipo_siniestro</rename><update>Y</update></value>
      <value><name>sk_semaforo</name><rename>sk_semaforo</rename><update>Y</update></value>
      <value><name>cantidad_siniestros</name><rename>cantidad_siniestros</rename><update>Y</update></value>
      <value><name>es_fatal</name><rename>es_fatal</rename><update>Y</update></value>
      <value><name>es_con_heridos</name><rename>es_con_heridos</rename><update>Y</update></value>
      <value><name>es_solo_danos</name><rename>es_solo_danos</rename><update>Y</update></value>
      <value><name>indice_gravedad</name><rename>indice_gravedad</rename><update>Y</update></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>2600</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Rechazos sin llave de tiempo</name>
    <type>TextFileOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <separator>;</separator><enclosure>"</enclosure><enclosure_forced>N</enclosure_forced><header>Y</header><footer>N</footer><format>DOS</format><compression>None</compression><encoding>UTF-8</encoding><endedLine/><fileNameInField>N</fileNameInField><create_parent_folder>Y</create_parent_folder>
    <file><name>${java.io.tmpdir}/rechazos_fact_siniestros</name><is_command>N</is_command><servlet_output>N</servlet_output><do_not_open_new_file_init>Y</do_not_open_new_file_init><extention>csv</extention><append>N</append><split>N</split><haspartno>N</haspartno><add_date>N</add_date><add_time>N</add_time><SpecifyFormat>N</SpecifyFormat><date_time_format/><add_to_result_filenames>N</add_to_result_filenames><pad>N</pad><fast_dump>N</fast_dump><splitevery>0</splitevery></file>
    <fields/>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>2600</xloc><yloc>300</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
