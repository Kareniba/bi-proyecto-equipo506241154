  <step>
    <name>Modified JavaScript value</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Indicadores de características del semáforo
var tiene_sonoro = 0;
var tiene_brt = 0;

// Identificador original
var id_origen = ID;

// Verificar si tiene grupos sonoros
if (GRUPOSSONOROS != null &amp;&amp;
    GRUPOSSONOROS != "" &amp;&amp;
    GRUPOSSONOROS != "&lt;null>") {
    tiene_sonoro = 1;
}

// Verificar si tiene grupos BRT
if (GRUPOS_BRT != null &amp;&amp;
    GRUPOS_BRT != "" &amp;&amp;
    GRUPOS_BRT != "&lt;null>") {
    tiene_brt = 1;
}

// Convertir fecha de instalación
var fecha_instalacion = null;

if (FECHAINSTALACION != null &amp;&amp;
    FECHAINSTALACION != "" &amp;&amp;
    FECHAINSTALACION != "&lt;null>") {

    var fechaTexto = FECHAINSTALACION.substring(0, 19);

    var anio = parseInt(fechaTexto.substring(0, 4), 10);
    var mes = parseInt(fechaTexto.substring(5, 7), 10);
    var dia = parseInt(fechaTexto.substring(8, 10), 10);
    var hora = parseInt(fechaTexto.substring(11, 13), 10);
    var minuto = parseInt(fechaTexto.substring(14, 16), 10);
    var segundo = parseInt(fechaTexto.substring(17, 19), 10);

    fecha_instalacion = new Date(
        anio,
        mes - 1,
        dia,
        hora,
        minuto,
        segundo
    );
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
