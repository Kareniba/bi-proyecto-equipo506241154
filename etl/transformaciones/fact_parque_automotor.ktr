      <key><name>COMBUSTIBLE</name><field>combustible</field><condition>=</condition><name2/></key><key><name>CLASE</name><field>clase</field><condition>=</condition><name2/></key><key><name>CARROCERIA</name><field>carroceria</field><condition>=</condition><name2/></key><key><name>MUNICIPIO</name><field>municipio</field><condition>=</condition><name2/></key><key><name>DEPARTAMENTO</name><field>departamento</field><condition>=</condition><name2/></key>
